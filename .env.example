# ==============================================================================
# Sentinel-X Environment Configuration Template (.env.example)
# Copy this file to .env for local configuration.
# DO NOT put real secrets, passwords, or private keys into .env.example.
# ==============================================================================

# Application Environment (development | testing | production)
SENTINEL_ENV=development

# Local Storage & Database Path (SQLite)
SENTINEL_DB_PATH=data/runtime/sentinel_x.db

# Application Logging
SENTINEL_LOG_LEVEL=INFO
SENTINEL_AUDIT_LOG_PATH=logs/audit.log

# Log Ingestion Limits
SENTINEL_MAX_INGEST_FILE_BYTES=10485760
SENTINEL_ALLOWED_INGEST_DIR=data/samples

# Dashboard / API Server Settings (Local-first binding)
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8080
SENTINEL_API_TOKEN=CHANGE_ME_LOCAL_API_TOKEN_PLACEHOLDER

# External Connectors (Leave empty unless configured with valid credentials)
SENTINEL_SIEM_ENDPOINT=
SENTINEL_SIEM_API_KEY=
SENTINEL_WEBHOOK_URL=
SENTINEL_THREAT_INTEL_API_KEY=

# Anti-REA / Release Protection Signing Configuration
# Path to external Ed25519 private/public keys (outside repository or in gitignored secrets/)
SENTINEL_RELEASE_PRIVATE_KEY_PATH=
SENTINEL_RELEASE_PUBLIC_KEY_PATH=
