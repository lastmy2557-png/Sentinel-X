{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/downloads/sentinel-x.exe",
      "destination": "https://github.com/lastmy2557-png/Sentinel-X/raw/main/dist/sentinel-x.exe"
    },
    {
      "source": "/downloads/latest.patch",
      "destination": "https://github.com/lastmy2557-png/Sentinel-X/raw/main/patches/latest.patch"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
