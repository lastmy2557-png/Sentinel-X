+                    r'(id="release-patch-sha256">SHA-256:\s*)[0-9a-fA-F]{64}(<)',
+                    rf'\g<1>{patch_sha}\2',
+                    html_content,
+                )
             index_html_path.write_text(html_content, encoding="utf-8")
             updated_version_files.append("public/index.html")
 
